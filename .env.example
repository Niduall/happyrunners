# Coordonnées par défaut pour la météo - Tomblaine
# (Open-Meteo est utilisé, il ne faut AUCUNE clé API)
VITE_DEFAULT_LAT=48.6833
VITE_DEFAULT_LON=6.2167

# Supabase (obligatoire)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon

# Code administrateur — déverrouille la modification et la suppression
# des parcours pour la session de l'onglet en cours.
# ⚠️ Il est lisible dans le bundle JS : c'est une protection contre la
#    maladresse et la curiosité, pas une sécurité. À définir aussi dans
#    Vercel (Settings > Environment Variables), sinon le verrouillage est
#    inactif en production. Laisser vide = aucun cadenas affiché.
VITE_ADMIN_CODE=changez_moi
